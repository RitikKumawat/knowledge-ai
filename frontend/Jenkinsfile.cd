pipeline {
    agent any

    parameters {
        string(name: 'IMAGE_TAG', description: 'The Docker image tag to deploy (e.g. 1.0.1)')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Setup Tools') {
            steps {
                sh """
                    # Download Helm
                    if [ ! -f "./helm" ]; then
                        curl -fsSL -o get_helm.sh https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3
                        chmod 700 get_helm.sh
                        HELM_INSTALL_DIR=\$PWD ./get_helm.sh --no-sudo
                    fi
                    
                    # Download kubectl
                    if [ ! -f "./kubectl" ]; then
                        curl -LO "https://dl.k8s.io/release/\$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl"
                        chmod +x kubectl
                    fi

                    # Download Argo Rollouts plugin
                    if [ ! -f "./kubectl-argo-rollouts" ]; then
                        curl -LO https://github.com/argoproj/argo-rollouts/releases/latest/download/kubectl-argo-rollouts-linux-amd64
                        chmod +x kubectl-argo-rollouts-linux-amd64
                        mv kubectl-argo-rollouts-linux-amd64 kubectl-argo-rollouts
                    fi
                """
            }
        }

        stage('Deploy with Helm') {
            steps {
                // Change into the helm chart directory
                dir('frontend/helm/knowledge-ai-frontend') {
                    sh """
                        # We use the downloaded helm binary
                        ../../../helm upgrade --install nextjs-canary . \\
                            -n nextjs-canary \\
                            --set image.tag=${params.IMAGE_TAG}
                    """
                }
            }
        }

        stage('Trigger Argo Rollout') {
            steps {
                sh """
                    echo "Checking rollout status..."
                    ./kubectl-argo-rollouts get rollout nextjs-canary-knowledge-ai-frontend -n nextjs-canary
                    
                    echo "Deployment to Kubernetes triggered via Argo Rollouts."
                    echo "If this is a new image version, the rollout should be paused at the first canary step."
                    echo "Please visit the Argo Rollouts Dashboard to promote it!"
                """
            }
        }
    }

    post {
        success {
            echo "CD Pipeline completed! Check Argo Rollouts Dashboard for the deployment progress of tag ${params.IMAGE_TAG}."
        }
        failure {
            echo "CD Pipeline failed!"
        }
    }
}
